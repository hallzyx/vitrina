# .env.example — copy to .env (NOT committed). No secrets or AWS credentials.
# Lambda uses its IAM role; locally use `aws login`.

# --- General ---
AWS_REGION=us-east-1
STAGE=prod
PUBLIC_BASE_URL=https://REPLACE_ME.cloudfront.net
ALLOWED_ORIGIN=https://REPLACE_ME.cloudfront.net

# --- Data ---
TABLE_STORES=vitrina-stores
TABLE_PRODUCTS=vitrina-products
TABLE_STATS=vitrina-stats
TABLE_LIMITS=vitrina-limits
BUCKET_RAW=vitrina-raw-REPLACE_ME
BUCKET_PROCESSED=vitrina-processed-REPLACE_ME

# --- Orchestration and AI (model IDs: confirm in the Bedrock console) ---
STATE_MACHINE_ARN=arn:aws:states:us-east-1:ACCOUNT_ID:stateMachine:vitrina-pipeline
# Amazon first-party models: no AWS Marketplace subscription needed.
BEDROCK_MODEL_TEXT=amazon.nova-pro-v1:0
BEDROCK_MODEL_EMBED=amazon.titan-embed-image-v1
# Background removal runs in the Lambda (ONNX); the model file is uploaded to the processed bucket.
SEGMENT_MODEL_KEY=models/isnet-general-use.onnx
FIDELITY_THRESHOLD=0.80
FIDELITY_MAX_DROP=0.05
MIN_SHARPNESS=12
MIN_SIDE_PX=600
MIN_PHOTOS=6
MAX_PHOTOS=24
MAX_PHOTO_MB=8

# --- 3D (optional) ---
ENABLE_3D=false
SAGEMAKER_ENDPOINT_NAME=

# --- Guardrails ---
# The access code value does NOT go here: it lives in SSM Parameter Store (SecureString).
ACCESS_CODE_PARAM_NAME=/vitrina/prod/access-code
MAX_STORES_PER_DAY=3
MAX_PRODUCTS_PER_DAY=3
MAX_GLOBAL_STORES_PER_DAY=20
MAX_GLOBAL_PRODUCTS_PER_DAY=30
MAX_FAILED_ATTEMPTS=10
EXAMPLE_STORE_SLUG=example

# --- Frontend (Vite build-time variables) ---
VITE_API_URL=https://REPLACE_ME.execute-api.us-east-1.amazonaws.com
VITE_PUBLIC_BASE_URL=https://REPLACE_ME.cloudfront.net
